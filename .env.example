# ---------------------------------------------------------------------------
# OpsPilot AI — environment configuration
# Copy to `.env` and adjust. Defaults are chosen so the system runs fully
# offline (fake providers) with zero API keys.
# ---------------------------------------------------------------------------

# --- Application ---
OPSPILOT_APP_ENV=local            # local | ci | staging | prod
OPSPILOT_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Database ---
# When running the API on the host against the compose DB:
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
# Inside docker-compose the API service overrides host to `db`.

# --- LLM provider (generation) ---
OPSPILOT_LLM_PROVIDER=fake        # fake | anthropic
OPSPILOT_LLM_MODEL=claude-sonnet-5
OPSPILOT_ANTHROPIC_API_KEY=       # required only when OPSPILOT_LLM_PROVIDER=anthropic
OPSPILOT_LLM_MAX_TOKENS=1024

# --- Embedding provider (semantic retrieval) ---
OPSPILOT_EMBEDDING_PROVIDER=local # local | fake
OPSPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPSPILOT_EMBEDDING_DIM=384        # must match the model; also fixes the pgvector column

# --- Retrieval / chunking ---
OPSPILOT_CHUNK_SIZE=512           # tokens (approx) per chunk
OPSPILOT_CHUNK_OVERLAP=64
OPSPILOT_RETRIEVAL_TOP_K=8
OPSPILOT_RETRIEVAL_STRATEGY=hybrid  # vector | lexical | hybrid  (hybrid = vector + FTS, RRF-fused)
OPSPILOT_RETRIEVAL_CANDIDATE_K=30   # candidates per arm before RRF fusion (hybrid only)
OPSPILOT_RRF_K=60                   # RRF smoothing constant

# --- Reranking (Phase 6) ---
OPSPILOT_RERANKER=none              # none | fake | cross_encoder
OPSPILOT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OPSPILOT_RERANK_CANDIDATE_K=20      # candidates fetched from retrieval, trimmed to TOP_K by the reranker

# --- Agentic investigation (Phase 8) ---
OPSPILOT_AGENT_MAX_TOOL_CALLS=6      # hard cap; a request can lower it via max_tool_calls, never raise it
OPSPILOT_AGENT_MAX_COST_USD=0.50
OPSPILOT_AGENT_MAX_SECONDS=60.0

# --- Prompting ---
OPSPILOT_PROMPT_VERSION=v1
